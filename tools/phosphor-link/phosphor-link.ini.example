; Phosphor Link settings. Copy to phosphor-link.ini next to phosphor-link.exe. Everything is optional.

; auto = SSH first when the SS1 is on the network (host= below, or the SS1 the Phosphor app is paired
; with), the dock's debug port otherwise. The boot log and reboots always use the debug port. Or: serial, ssh
transport=auto

; auto finds the dock's USB serial port by asking it. Or name it: COM5 (Windows), /dev/ttyUSB0 (Linux)
port=auto
baud=115200

; MiSTer login on the serial console (stock MiSTer: root / 1)
user=root
password=1

; SSH. Leave host unset to use the SS1 the Phosphor app is paired with.
;host=192.168.1.50
ssh_user=root
ssh_password=1

; everything the console prints is appended here (default: phosphor-link.log next to the program)
;log=C:\phosphor\phosphor-link.log
